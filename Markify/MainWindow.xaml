<Window x:Class="Markify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Markify"
        xmlns:textify="clr-namespace:Markify.Textify;assembly=MarkifyTextBox"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <textify:MarkifyTextBox x:Name="Editor"
                            Margin="12"
                            Text=""
                            EnableMarkdownHeadings="True"
                            EnableMarkdownHorizontalRules="True"
                            FontFamily="Consolas"
                            FontSize="14" />
    </Grid>
</Window>
